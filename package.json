{
  "name": "gantt-timeline",
  "version": "1.0.0",
  "private": true,
  "description": "Clinical Trial Timeline & Gantt Chart Generator",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && node --watch index.js",
    "dev:client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "start": "cd server && node index.js",
    "seed": "cd server && node db/seed.js",
    "setup": "npm install && cd server && npm install && cd ../client && npm install"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
